# =============================================================================
# BACKEND - ToutAunClicLa  ·  Variables de entorno
# =============================================================================
# En DESARROLLO se cargan desde: .env.development.local  (ver src/config/env.js)
# En PRODUCCIÓN (Railway) se inyectan como variables del host.
#
# Copia este archivo:
#   - Desarrollo:  cp .env.example .env.development.local
#   - Producción:  configura cada variable en el panel de Railway
# =============================================================================

# --- Entorno ---------------------------------------------------------------
# 'development' | 'production'. En production se activa Arcjet en modo LIVE.
NODE_ENV=development

# Puerto del servidor. Por defecto 5500 en dev (ver env.js). Railway lo inyecta.
PORT=5500

# --- Supabase (OBLIGATORIO) ------------------------------------------------
# Sin estas 3 el servidor lanza "Missing Supabase environment variables".
# Disponibles en: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...            # public anon key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...    # service_role key (SECRETO, solo backend)

# --- Autenticación (OBLIGATORIO) -------------------------------------------
# Secreto para firmar/verificar los JWT propios. Cadena larga y aleatoria.
# DEBE ser idéntico al JWT_SECRET del frontend (middleware.ts lo usa).
JWT_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# --- Stripe (OBLIGATORIO para pagos) ---------------------------------------
# sk_test_... activa modo TEST automáticamente; sk_live_... activa LIVE.
# config/stripe.js lanza error si falta STRIPE_SECRET_KEY.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
# Secreto del endpoint de webhooks (Stripe Dashboard > Developers > Webhooks).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# --- URLs -------------------------------------------------------------------
# URL del frontend. Usada para redirecciones de checkout/order-confirmation
# Y para el allow-list de CORS (server.js). DEBE ser el dominio exacto del front.
# Dev: http://localhost:3000  ·  Prod: https://www.toutaunclicla.com
FRONTEND_URL=http://localhost:3000

# --- Resend (emails transaccionales, recomendado) --------------------------
# Si falta, los emails quedan deshabilitados (solo warning, no crash).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# --- Admin ------------------------------------------------------------------
# Lista de correos admin separados por comas (sin espacios sobran, se trim-ean).
ADMIN_EMAILS=admin1@toutaunclicla.com,admin2@toutaunclicla.com

# =============================================================================
# MÓDULO PRO (Servicios) — tarjetas digitales y suscripciones
# =============================================================================

# --- Stripe Pro: Price IDs de las suscripciones ----------------------------
# Crear los productos/precios en Stripe (CAD) y pegar aquí los price_...
# DEV: precios en modo TEST  ·  PROD: recrear en modo LIVE (otros IDs).
#   Pro  $25/mes · $250/año   |   Max  $45/mes · $450/año
STRIPE_PRICE_PRO_MENSUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO_ANUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_MAX_MENSUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_MAX_ANUAL=price_xxxxxxxxxxxx

# --- Stripe Pro: webhook (endpoint SEPARADO del e-commerce) ----------------
# Dev:  lo imprime `stripe listen --forward-to localhost:5500/api/v1/pro/webhook`
# Prod: Stripe Dashboard > Webhooks > endpoint .../api/v1/pro/webhook (otro secret)
STRIPE_PRO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx

# --- Stripe Tax (GST/QST) --------------------------------------------------
# 'true' activa el cálculo automático de impuestos en el checkout Pro.
# Requiere registros fiscales en Stripe. Dejar en false hasta tenerlos.
STRIPE_TAX_ENABLED=false

# -----------------------------------------------------------------------------
# NOTA: estas variables están declaradas en src/config/env.js pero NO se usan
# en ningún punto del código, así que NO hace falta configurarlas:
#   - STRIPE_PUBLISHABLE_KEY  (clave de frontend; el backend solo usa la secret)
#   - GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI
#     (el login con Google lo gestiona Supabase desde el frontend)
# -----------------------------------------------------------------------------
