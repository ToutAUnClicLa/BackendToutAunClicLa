# Copy to .env.development.local (dev). Railway: set the same names in the service.
# Code reads only the names below (src/config/env.js + importers).

# --- Required --------------------------------------------------------------
# development | production. Fallback: development (loads .env.development.local).
NODE_ENV=development

# Local default 5500. Railway injects PORT — do not pin 5500 on the host.
PORT=5500

# Boot throws if any of these three is missing.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJI...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJI...

# Must match frontend JWT_SECRET. Boot OK if unset; login/JWT verify fail later.
JWT_SECRET=replace-with-a-long-random-string

# sk_test_ → TEST; anything else → LIVE. Missing → throw at boot.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx

# Shop POST /api/v1/stripe/webhook. Different secret from the Pro webhook.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Pro POST /api/v1/pro/webhook. Local: second `stripe listen` (one CLI = one path).
STRIPE_PRO_WEBHOOK_SECRET=whsec_yyyyyyyyyyyyyyyy

# Live vs test: live Price IDs with sk_live_; test IDs on live keys fail at Checkout.
# CAD: Pro $25/mes $250/año · Max $45/mes $450/año
STRIPE_PRICE_PRO_MENSUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO_ANUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_MAX_MENSUAL=price_xxxxxxxxxxxx
STRIPE_PRICE_MAX_ANUAL=price_xxxxxxxxxxxx

# Prod origin. No trailing slash (CORS + Stripe URL concat). Not the Vercel preview.
FRONTEND_URL=http://localhost:3000

# --- Optional --------------------------------------------------------------
# Extra CORS origin (Vercel Preview). No trailing slash. Required if Preview calls Railway.
FRONTEND_DEVELOP_URL=https://your-app-git-branch.vercel.app

# Missing: some sends no-op; order/restaurant mail can fail at send time.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Comma-separated. Empty → no admin emails / super-admin gate.
ADMIN_EMAILS=admin@example.com

# true only after Stripe Tax registrations. Missing → false.
STRIPE_TAX_ENABLED=false
